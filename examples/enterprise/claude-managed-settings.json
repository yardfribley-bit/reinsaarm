{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/reinsaarm hook --client claude-code",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "allowManagedHooksOnly": true
}
